# Only code, tests, lightweight output and repository metadata are eligible.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/uv.lock
!/versions/
!/tests/
!/results/

# Reviewed text output only; no raw archives, weights, predictions or arbitrary files.
/results/**
!/results/README.md
!/results/V[0-9][0-9]/
!/results/V[0-9][0-9]/*/
!/results/V[0-9][0-9]/*/notes.md
!/results/V[0-9][0-9]/*/metrics.json
!/results/_unassigned/
!/results/_unassigned/*/
!/results/_unassigned/*/notes.md
!/results/_unassigned/*/metrics.json

# Personal tracking, agent rules and private project documents at any depth.
AGENTS.md
agents.md
plan.md
PLAN.md
rule.md
rules.md
rubric.md
rubik.md
HUONG_DAN_TIEN_DO.md
*TIEN_DO*
*tien_do*
*Ke_hoach*
*ke_hoach*
.agents/
.codex/
.aws/
.ssh/
/docs/
/reports/
/noiquy/
/data/
/weights/
/outputs/

