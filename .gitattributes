# Preserve bytes used by notebook/source hash verification across checkouts.
/versions/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/results/** text eol=lf
/README.md text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
/pyproject.toml text eol=lf
/uv.lock text eol=lf
